# Local development: the API and short-link redirects run on the backend.
BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_PUBLIC_URL=http://localhost:8080

# AWS production, when frontend and backend run as containers on linkito-net:
# BACKEND_URL=http://linkito-backend:8080
# NEXT_PUBLIC_PUBLIC_URL=https://100.58.229.18
# BACKEND_URL is read by the server at runtime. NEXT_PUBLIC_PUBLIC_URL is
# embedded in the browser bundle at build time; rebuild if the public URL changes.
# Keep credentials out of NEXT_PUBLIC_* variables.
